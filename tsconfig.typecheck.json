{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["@tauri-apps/api", "vitest/globals", "@testing-library/jest-dom", "node"],
    "noEmit": true,
    "composite": false,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/components/ui/*": ["./src/ui/components/ui/*"]
    }
  },
  "include": [
    "src/lib/**/*",
    "src/hooks/**/*",
    "src/commands/**/*",
    "src/components/**/*",
    "src/context/**/*",
    "src/ui/**/*",
    "src/adapters/**/*",
    "src/types/**/*",
    "src/utils/**/*"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts", "src/test", "src/pages"]
}
