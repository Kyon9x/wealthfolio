{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Main app specific settings
    "types": ["@tauri-apps/api", "vitest/globals", "@testing-library/jest-dom", "node"],
    "noEmit": true,
    "composite": false,
    // Path mapping for main app
    "paths": {
      "@/*": ["./src/*"],
      "@/components/ui/*": ["./src/ui/components/ui/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts", "src/test"],
  "references": [
    { "path": "./tsconfig.node.json" }
  ]
}
